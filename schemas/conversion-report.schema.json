{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeo.example/schemas/conversion-report.schema.json",
  "title": "OpenGeo interoperability conversion report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "conversionId",
    "direction",
    "source",
    "target",
    "policy",
    "summary",
    "fields",
    "losses",
    "warnings"
  ],
  "properties": {
    "$schema": {"const": "../schemas/conversion-report.schema.json"},
    "schemaVersion": {"const": "1.0.0"},
    "conversionId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "direction": {"enum": ["import", "export"]},
    "source": {"$ref": "#/$defs/product"},
    "target": {"$ref": "#/$defs/product"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkAccess", "sensitiveValues", "unknownFields", "sizeLimitBytes"],
      "properties": {
        "networkAccess": {"const": "disabled"},
        "sensitiveValues": {"const": "reject"},
        "unknownFields": {"const": "preserve_extension"},
        "sizeLimitBytes": {"type": "integer", "minimum": 1024, "maximum": 10485760}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mapped", "preserved", "defaulted", "rejected", "unsupported"],
      "properties": {
        "status": {"enum": ["lossless", "preserved_with_extensions", "lossy", "rejected"]},
        "mapped": {"type": "integer", "minimum": 0},
        "preserved": {"type": "integer", "minimum": 0},
        "defaulted": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0}
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "outcome", "message"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "targetPath": {"type": "string", "minLength": 1, "maxLength": 500},
          "outcome": {"enum": ["mapped", "preserved_extension", "defaulted", "rejected_sensitive", "unsupported"]},
          "message": {"type": "string", "minLength": 3, "maxLength": 1000}
        }
      }
    },
    "losses": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 1000}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 3, "maxLength": 1000}}
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "commit"],
      "properties": {
        "product": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
