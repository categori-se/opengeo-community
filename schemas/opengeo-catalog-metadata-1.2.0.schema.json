{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeo.example/schemas/opengeo-catalog-metadata-1.2.0.schema.json",
  "title": "OpenGeo native catalog metadata",
  "description": "The value of metadata_extensions.opengeo for schema version 1.2.0. Cross-record identifier uniqueness, acquisition references, timezone-aware date parsing, and date ordering are additionally enforced by the OpenGeo API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": "1.2.0"},
    "contacts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [{"required": ["name"]}, {"required": ["organization"]}],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 300},
          "organization": {"type": "string", "minLength": 1, "maxLength": 300},
          "email": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"},
          "role": {"type": "string", "minLength": 1, "maxLength": 300},
          "identifier": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "distributions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "anyOf": [{"required": ["accessUrl"]}, {"required": ["downloadUrl"]}],
        "properties": {
          "identifier": {"type": "string", "minLength": 1, "maxLength": 1000},
          "title": {"type": "string", "minLength": 1, "maxLength": 1000},
          "accessUrl": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://[^\\s]+$"},
          "downloadUrl": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://[^\\s]+$"},
          "mediaType": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:\\s*;\\s*[^\\s=;]+=[^;]+)*$"},
          "format": {"type": "string", "minLength": 1, "maxLength": 1000},
          "byteSize": {"type": "integer", "minimum": 0, "maximum": 1000000000000000000},
          "checksumSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "referenceSystems": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
          "uri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:https?://|urn:)[^\\s]+$"}
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "sources": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
      }
    },
    "quality": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measure", "result"],
        "properties": {
          "measure": {"type": "string", "minLength": 1, "maxLength": 300},
          "result": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "number"}, {"type": "boolean"}]},
          "unit": {"type": "string", "minLength": 1, "maxLength": 1000},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "updateFrequency": {"type": "string", "minLength": 1, "maxLength": 300},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "funding": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["funderName"],
        "dependentRequired": {
          "funderIdentifier": ["funderIdentifierType"],
          "funderIdentifierType": ["funderIdentifier"],
          "schemeUri": ["funderIdentifier"],
          "awardUri": ["awardNumber"]
        },
        "properties": {
          "funderName": {"type": "string", "minLength": 1, "maxLength": 300},
          "funderIdentifier": {"type": "string", "minLength": 1, "maxLength": 2048},
          "funderIdentifierType": {"enum": ["ISNI", "GRID", "ROR", "Crossref Funder ID", "Other"]},
          "schemeUri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:https?://|urn:)[^\\s#]+$"},
          "awardNumber": {"type": "string", "minLength": 1, "maxLength": 300},
          "awardUri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:https?://|urn:)[^\\s#]+$"},
          "awardTitle": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["instruments"]}, {"required": ["platforms"]},
        {"required": ["operations"]}, {"required": ["plans"]},
        {"required": ["objectives"]}, {"required": ["requirements"]}
      ],
      "properties": {
        "instruments": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["identifier", "type"],
            "properties": {
              "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
              "type": {"type": "string", "minLength": 1, "maxLength": 300},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        },
        "platforms": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["identifier", "description", "instrumentIdentifiers"],
            "properties": {
              "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000},
              "instrumentIdentifiers": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
            }
          }
        },
        "operations": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["identifier", "status"],
            "properties": {
              "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
              "description": {"type": "string", "minLength": 1, "maxLength": 1000},
              "status": {"enum": ["completed", "historicalArchive", "obsolete", "onGoing", "planned", "required", "underDevelopment", "final", "pending", "retired", "superseded", "tentative", "valid", "accepted", "notAccepted", "withdrawn", "proposed"]},
              "type": {"enum": ["real", "simulated", "synthesized"]}
            }
          }
        },
        "objectives": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["identifier"],
            "properties": {
              "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
              "priority": {"type": "string", "minLength": 1, "maxLength": 300},
              "types": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["instantaniousCollection", "persistantView", "survey"]}},
              "functions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
              "instrumentIdentifiers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
            }
          }
        },
        "requirements": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["identifier", "requestors", "recipients", "priority", "requestedDate", "expiryDate"],
            "properties": {
              "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
              "requestors": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
              "recipients": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
              "priority": {"enum": ["critical", "highImportance", "mediumImportance", "lowImportance"]},
              "requestedDate": {
                "type": "object", "additionalProperties": false,
                "required": ["requestedDateOfCollection", "latestAcceptableDate"],
                "properties": {
                  "requestedDateOfCollection": {"type": "string", "maxLength": 100, "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
                  "latestAcceptableDate": {"type": "string", "maxLength": 100, "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
                }
              },
              "expiryDate": {"type": "string", "maxLength": 100, "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
            }
          }
        },
        "plans": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["identifier", "status"],
            "properties": {
              "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
              "status": {"enum": ["completed", "historicalArchive", "obsolete", "onGoing", "planned", "required", "underDevelopment", "final", "pending", "retired", "superseded", "tentative", "valid", "accepted", "notAccepted", "withdrawn", "proposed"]},
              "type": {"enum": ["areal", "linear", "point", "strip"]},
              "operationIdentifiers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
              "requirementIdentifiers": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
            }
          }
        }
      }
    }
  }
}
