{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeo.example/schemas/opengeo-catalog-metadata-1.3.0.schema.json",
  "title": "OpenGeo native catalog metadata",
  "description": "The value of metadata_extensions.opengeo for schema version 1.3.0. Cross-record identifier uniqueness, acquisition references, timezone-aware date parsing, and date ordering are additionally enforced by the OpenGeo API.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 300},
    "identifierList32": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "dateTime": {"type": "string", "maxLength": 100, "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "status": {"enum": ["completed", "historicalArchive", "obsolete", "onGoing", "planned", "required", "underDevelopment", "final", "pending", "retired", "superseded", "tentative", "valid", "accepted", "notAccepted", "withdrawn", "proposed"]}
  },
  "properties": {
    "schemaVersion": {"const": "1.3.0"},
    "contacts": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "anyOf": [{"required": ["name"]}, {"required": ["organization"]}],
        "properties": {
          "name": {"$ref": "#/$defs/identifier"},
          "organization": {"$ref": "#/$defs/identifier"},
          "email": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"},
          "role": {"$ref": "#/$defs/identifier"},
          "identifier": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "distributions": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "anyOf": [{"required": ["accessUrl"]}, {"required": ["downloadUrl"]}],
        "properties": {
          "identifier": {"type": "string", "minLength": 1, "maxLength": 1000},
          "title": {"type": "string", "minLength": 1, "maxLength": 1000},
          "accessUrl": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://[^\\s]+$"},
          "downloadUrl": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://[^\\s]+$"},
          "mediaType": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+(?:\\s*;\\s*[^\\s=;]+=[^;]+)*$"},
          "format": {"type": "string", "minLength": 1, "maxLength": 1000},
          "byteSize": {"type": "integer", "minimum": 0, "maximum": 1000000000000000000},
          "checksumSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "referenceSystems": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["identifier"],
        "properties": {
          "identifier": {"$ref": "#/$defs/identifier"},
          "uri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:https?://|urn:)[^\\s]+$"}
        }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["statement"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "sources": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 2048}}
      }
    },
    "quality": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["measure", "result"],
        "properties": {
          "measure": {"$ref": "#/$defs/identifier"},
          "result": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1000}, {"type": "number"}, {"type": "boolean"}]},
          "unit": {"type": "string", "minLength": 1, "maxLength": 1000},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "updateFrequency": {"$ref": "#/$defs/identifier"},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "funding": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["funderName"],
        "dependentRequired": {"funderIdentifier": ["funderIdentifierType"], "funderIdentifierType": ["funderIdentifier"], "schemeUri": ["funderIdentifier"], "awardUri": ["awardNumber"]},
        "properties": {
          "funderName": {"$ref": "#/$defs/identifier"},
          "funderIdentifier": {"type": "string", "minLength": 1, "maxLength": 2048},
          "funderIdentifierType": {"enum": ["ISNI", "GRID", "ROR", "Crossref Funder ID", "Other"]},
          "schemeUri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:https?://|urn:)[^\\s#]+$"},
          "awardNumber": {"$ref": "#/$defs/identifier"},
          "awardUri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?:https?://|urn:)[^\\s#]+$"},
          "awardTitle": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "anyOf": [
        {"required": ["instruments"]}, {"required": ["platforms"]}, {"required": ["operations"]},
        {"required": ["plans"]}, {"required": ["objectives"]}, {"required": ["requirements"]},
        {"required": ["platformPasses"]}, {"required": ["events"]}
      ],
      "properties": {
        "instruments": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identifier", "type"],
            "properties": {"identifier": {"$ref": "#/$defs/identifier"}, "type": {"$ref": "#/$defs/identifier"}, "description": {"type": "string", "minLength": 1, "maxLength": 1000}}
          }
        },
        "platforms": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identifier", "description", "instrumentIdentifiers"],
            "properties": {"identifier": {"$ref": "#/$defs/identifier"}, "description": {"type": "string", "minLength": 1, "maxLength": 1000}, "instrumentIdentifiers": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}
          }
        },
        "operations": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identifier", "status"],
            "properties": {"identifier": {"$ref": "#/$defs/identifier"}, "description": {"type": "string", "minLength": 1, "maxLength": 1000}, "status": {"$ref": "#/$defs/status"}, "type": {"enum": ["real", "simulated", "synthesized"]}, "eventIdentifiers": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}}
          }
        },
        "objectives": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identifier"],
            "properties": {
              "identifier": {"$ref": "#/$defs/identifier"}, "priority": {"$ref": "#/$defs/identifier"},
              "types": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["instantaniousCollection", "persistantView", "survey"]}},
              "functions": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
              "instrumentIdentifiers": {"$ref": "#/$defs/identifierList32"}, "passIdentifiers": {"$ref": "#/$defs/identifierList32"}, "eventIdentifiers": {"$ref": "#/$defs/identifierList32"}
            }
          }
        },
        "platformPasses": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"type": "object", "additionalProperties": false, "required": ["identifier"], "properties": {"identifier": {"$ref": "#/$defs/identifier"}, "eventIdentifiers": {"$ref": "#/$defs/identifierList32"}}}
        },
        "events": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identifier", "trigger", "context", "sequence", "time"],
            "properties": {
              "identifier": {"$ref": "#/$defs/identifier"}, "trigger": {"enum": ["automatic", "manual", "PreProgrammed"]},
              "context": {"enum": ["acquisition", "pass", "wayPoint"]}, "sequence": {"enum": ["start", "end", "instantaneous"]},
              "time": {"$ref": "#/$defs/dateTime"}, "passIdentifier": {"$ref": "#/$defs/identifier"},
              "instrumentIdentifiers": {"$ref": "#/$defs/identifierList32"}, "objectiveIdentifiers": {"$ref": "#/$defs/identifierList32"}
            }
          }
        },
        "requirements": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identifier", "requestors", "recipients", "priority", "requestedDate", "expiryDate"],
            "properties": {
              "identifier": {"$ref": "#/$defs/identifier"},
              "requestors": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
              "recipients": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
              "priority": {"enum": ["critical", "highImportance", "mediumImportance", "lowImportance"]},
              "requestedDate": {"type": "object", "additionalProperties": false, "required": ["requestedDateOfCollection", "latestAcceptableDate"], "properties": {"requestedDateOfCollection": {"$ref": "#/$defs/dateTime"}, "latestAcceptableDate": {"$ref": "#/$defs/dateTime"}}},
              "expiryDate": {"$ref": "#/$defs/dateTime"}
            }
          }
        },
        "plans": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["identifier", "status"],
            "properties": {"identifier": {"$ref": "#/$defs/identifier"}, "status": {"$ref": "#/$defs/status"}, "type": {"enum": ["areal", "linear", "point", "strip"]}, "operationIdentifiers": {"$ref": "#/$defs/identifierList32"}, "requirementIdentifiers": {"$ref": "#/$defs/identifierList32"}}
          }
        }
      }
    }
  }
}
