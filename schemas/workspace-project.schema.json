{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceProject",
  "type": "object",
  "required": ["workspaceId", "tenantId", "mapViews", "layers", "basemaps", "activeLayerId", "updatedBy", "updatedAt"],
  "properties": {
    "version": {"type": "string"},
    "workspaceId": {"type": "string"},
    "tenantId": {"type": "string"},
    "mapViews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["viewId", "center", "zoom"],
        "properties": {
          "viewId": {"type": "string"},
          "center": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          },
          "zoom": {"type": "number"},
          "pitch": {"type": "number"},
          "bearing": {"type": "number"}
        }
      }
    },
    "layers": {"type": "array", "items": {"type": "string"}},
    "basemaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["basemapId", "title", "url", "visible", "opacity"],
        "properties": {
          "basemapId": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "visible": {"type": "boolean"},
          "opacity": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "bookmarks": {"type": "array"},
    "styles": {"type": "object"},
    "legend": {"type": "object"},
    "preferences": {"type": "object"},
    "widgets": {"type": "array"},
    "dashboardColumns": {"type": "integer", "minimum": 1, "maximum": 6},
    "storymap": {"type": "object"},
    "models": {"type": "array"},
    "metadata": {"type": "object"},
    "activeLayerId": {"type": "string"},
    "updatedBy": {"type": "string"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
