{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeo.tools/schemas/opengeo-map-filter-1.0.0.schema.json",
  "title": "Bounded saved MapLibre feature filter",
  "description": "Native expression predicates. Implementations additionally enforce 64 predicates, nesting depth 8 and 8192 serialized characters.",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "$ref": "#/$defs/predicate"
    }
  ],
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 17,
          "prefixItems": [
            {
              "enum": [
                "all",
                "any"
              ]
            }
          ],
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "!"
            },
            {
              "$ref": "#/$defs/predicate"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "has"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "enum": [
                "==",
                "!="
              ]
            },
            {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "const": "get"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ],
                  "items": false
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            },
            {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 1024
                }
              ]
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "enum": [
                "<",
                "<=",
                ">",
                ">="
              ]
            },
            {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "const": "get"
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  ],
                  "items": false
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ]
            },
            {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 1024
                }
              ]
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "in"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "const": "get"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              ],
              "items": false
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "const": "literal"
                },
                {
                  "oneOf": [
                    {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "string",
                        "maxLength": 1024
                      }
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "number"
                      }
                    }
                  ]
                }
              ],
              "items": false
            }
          ],
          "items": false
        }
      ]
    }
  }
}
