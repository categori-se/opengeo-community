{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeo.example/schemas/parity-fixture.schema.json",
  "title": "OpenGeo parity fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "title",
    "fixtureType",
    "source",
    "license",
    "sensitivity",
    "artifacts",
    "expectedOutcomes",
    "constraints"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "fixtureId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 200},
    "fixtureType": {
      "enum": ["dataset", "project", "service", "configuration", "interaction", "publication"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {"enum": ["synthetic", "upstream"]},
        "description": {"type": "string", "minLength": 5, "maxLength": 500},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "version": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxId", "redistributable"],
      "properties": {
        "spdxId": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+$"},
        "redistributable": {"const": true}
      }
    },
    "sensitivity": {"const": "public"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mediaType", "encoding", "value", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "mediaType": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
          "encoding": {"enum": ["base64", "utf8", "path"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 1048576},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "expectedOutcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rowId", "assertion"],
        "properties": {
          "rowId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
          "assertion": {"type": "string", "minLength": 5, "maxLength": 500}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline", "containsPersonalData", "requiresCredentials"],
      "properties": {
        "offline": {"type": "boolean"},
        "containsPersonalData": {"const": false},
        "requiresCredentials": {"const": false}
      }
    }
  }
}
