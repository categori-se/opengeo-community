{
  "name": "@opengeo/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "synth": "cdk synth",
    "synth:dev": "cdk synth -c stage=dev -c budgetAlertEmail=opengeo-ci@example.invalid -c webOrigin=http://localhost:3000",
    "synth:community": "cdk synth --app 'node --import tsx bin/opengeo-community.ts'"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1137.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2"
  },
  "license": "Apache-2.0"
}
