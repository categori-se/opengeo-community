{
  "name": "opengeo-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm --prefix app run dev --",
    "build:studio": "npm --prefix app run build:studio --",
    "foundations:check": "node scripts/check-open-source-foundations.mjs",
    "community:dev": "python3 scripts/run-integrated-studio-local.py --development --state-directory .opengeo/community",
    "community:check": "python3 -m unittest discover -s scripts -p test_integrated_local.py",
    "community:aws:check": "python3 -m unittest discover -s scripts -p test_community_aws.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/categori-se/opengeo-community.git"
  }
}
