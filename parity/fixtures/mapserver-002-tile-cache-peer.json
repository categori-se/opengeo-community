  "expectedOutcomes": [
    {
      "rowId": "mapserver.tile-caching",
      "assertion": "Exact MapServer 8.6.5 returns a deterministic 256-pixel PNG for a valid MODE=tile request and no image for a malformed coordinate request."
    },
    {
      "rowId": "mapserver.tile-caching",
      "assertion": "OpenGeo binds seeded entries to tenant, service binding, dataset generation, render profile, cache generation, matrix, row, and column; it returns no image for invalid coordinates and rechecks current permission so missing, stale, anonymous, and membership-revoked reads are denied without creating work."
    },
    {
      "rowId": "mapserver.tile-caching",
      "assertion": "Bounded explicit seed plans, immutable invalidation, no automatic expiry, reference-aware manual reclamation, and QGIS and OpenLayers reads complete the cache lifecycle while adding $0 incremental fixed inactive compute for the cache capability."
    }
  ],
