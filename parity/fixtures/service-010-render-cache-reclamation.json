    {
      "rowId": "geonode.publishing-administration",
      "assertion": "Referenced map renders remain protected by every retained project-site edition manifest while unreferenced retired-generation outputs can release storage."
    },
    {
      "rowId": "geoserver.data-services",
      "assertion": "OpenGeo independently retains WMTS/cache history while physically reclaiming exact obsolete single-layer render versions through an explicit manager action."
    },
    {
      "rowId": "geoserver.security-caching",
      "assertion": "Retired cache generations have a tenant-safe, reference-aware, bounded, auditable, exact-version physical reclamation lifecycle."
    },
    {
      "rowId": "mapserver.ogc-publication",
      "assertion": "Obsolete PNG/SVG render storage can be reclaimed without an always-on MapServer, cache collector, scheduler, or warm worker."
    }
