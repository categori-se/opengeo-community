  "expectedOutcomes": [
    {
      "rowId": "geolibre.gis-authoring-inspection",
      "assertion": "The standalone browser captures schema-valid spatial observations offline, replays stable identities, and promotes only reviewed records into the native feature store without requiring GeoLibre."
    },
    {
      "rowId": "geonode.upload-create-edit-style",
      "assertion": "A managed vector collection supports versioned forms, quarantine, correction, review, and stable-ID promotion while richer form rules, attachments, and upstream migration remain explicit gaps."
    },
    {
      "rowId": "geonode.sharing-community",
      "assertion": "Project reviewers receive an explicit optimistic review lifecycle with immutable events and shared-auth attribution, without claiming comments, notifications, ratings, or complete workflow parity."
    },
    {
      "rowId": "openlayers.controls-interactions",
      "assertion": "The browser exposes geometry input and bounded GPS Point capture while independent OpenLayers, broader geolocation controls, touch/accessibility, and device coverage remain open."
    },
    {
      "rowId": "openlayers.browser-platform-features",
      "assertion": "IndexedDB queueing, sealed credential-free app-shell caching, offline route recovery, and client-assisted ordered replay are executable locally without bearer persistence; OS-installed windows, closed-window credentialed replay, physical devices, and deployment remain unclaimed."
    }
  ],
