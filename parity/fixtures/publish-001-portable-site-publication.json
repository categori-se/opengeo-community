  "expectedOutcomes": [
    {
      "rowId": "geolibre.layout-story-dashboard-print",
      "assertion": "A mixed-content site publishes versioned stories, documents, dashboards, or maps; accepts scanned PNG/JPEG/PDF/ODT with exact semantic pages, bounded PDF visuals, and page-level OCR provenance; and exports responsive editions with governed assets, exact legends, visually edited map/image/table/chart frames, flow/formal/positioned PDF with embedded searchable Unicode bitmap glyphs, common implicit-RTL Arabic/Persian/Urdu shaping, matching Unicode whole-page PNG, and accessible SVG."
    },
