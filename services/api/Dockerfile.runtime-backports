# Opt-in candidate runtime. Build on native ARM64; acceptance does not imply release approval.
FROM python:3.13.15-alpine3.23@sha256:7ea3f82de8ea6d4fb7e5d2bbe3fe3c9d931700b7a529f1fe5769e42abe514ca1 AS build
RUN apk add --no-cache build-base
WORKDIR /build
COPY scripts/fetch_pinned_https_asset.py scripts/apply_runtime_security_backports.py scripts/build_zlib_backport.py scripts/check_zlib_nonblocking.c ./
RUN python fetch_pinned_https_asset.py --output /build/zlib.tar.gz \
      --sha256 bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 \
      --max-bytes 2097152 --attempts 1 --timeout 20 \
      https://zlib.net/zlib-1.3.2.tar.gz \
    && python build_zlib_backport.py /build/zlib.tar.gz /out \
    && apk info -v > /out/build-packages.txt

FROM python:3.13.15-alpine3.23@sha256:7ea3f82de8ea6d4fb7e5d2bbe3fe3c9d931700b7a529f1fe5769e42abe514ca1
COPY --from=build /out/libz.so.1.3.2 /usr/lib/libz.so.1.3.2
COPY --from=build /out/receipt.json /out/build-packages.txt /out/README /out/zlib.h /usr/local/share/opengeo-runtime/
COPY --from=build /out/nonblocking-shared-check /usr/local/bin/opengeo-zlib-regression
COPY scripts/apply_runtime_security_backports.py /tmp/apply_runtime_security_backports.py
RUN python /tmp/apply_runtime_security_backports.py python-tarfile /usr/local/lib/python3.13/tarfile.py \
    && python -m py_compile /usr/local/lib/python3.13/tarfile.py \
    && /usr/local/bin/opengeo-zlib-regression \
    && python -c 'import hashlib,json,pathlib,tarfile,zlib; r=json.loads(pathlib.Path("/usr/local/share/opengeo-runtime/receipt.json").read_text()); assert r["arm64Runtime"]; assert hashlib.sha256(pathlib.Path("/usr/lib/libz.so.1.3.2").read_bytes()).hexdigest()==r["librarySha256"]; assert hashlib.sha256(pathlib.Path(tarfile.__file__).read_bytes()).hexdigest()=="7ad04a66bb92373bd6d2552a2f01fce8a4ca95463ebf661612fd574465977929"; assert zlib.decompress(zlib.compress(b"opengeo runtime"))==b"opengeo runtime"' \
    && rm /tmp/apply_runtime_security_backports.py
