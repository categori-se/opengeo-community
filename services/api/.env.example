OPEN_GEO_ENV=dev
OPEN_GEO_LOG_LEVEL=INFO
OPEN_GEO_EXPOSE_DOCS=true
OPEN_GEO_DB_HOST=
OPEN_GEO_DB_PORT=5432
OPEN_GEO_DB_NAME=opengeo
OPEN_GEO_DB_USER=
OPEN_GEO_DB_PASSWORD=
OPEN_GEO_DB_SSLMODE=require
OPEN_GEO_DB_SSLROOTCERT=
OPEN_GEO_DATABASE_QUERY_TIMEOUT_SECONDS=10
# Alternative to the direct OPEN_GEO_DB_* group for the IDLE-001 prototype:
# OPEN_GEO_DATA_API_REGION=us-east-1
# OPEN_GEO_DATA_API_CLUSTER_ARN=arn:aws:rds:us-east-1:111111111111:cluster:opengeo-serverless
# OPEN_GEO_DATA_API_SECRET_ARN=arn:aws:secretsmanager:us-east-1:111111111111:secret:opengeo/runtime-AbCd
# OPEN_GEO_DATA_API_RESUME_TIMEOUT_SECONDS=12
OPEN_GEO_COGNITO_REGION=us-east-1
OPEN_GEO_COGNITO_USER_POOL_ID=
OPEN_GEO_COGNITO_CLIENT_ID=
OPEN_GEO_AWS_REGION=us-east-1
OPEN_GEO_GEODATA_BUCKET=
OPEN_GEO_GEODATA_KMS_KEY_ARN=
OPEN_GEO_PROCESSING_QUEUE_URL=
