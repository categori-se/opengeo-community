{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable resource references and envelopes, version 1",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authority", "resource_id", "resource_type", "workspace_id"],
      "properties": {
        "schema_version": {"const": 1},
        "authority": {"type": "string", "maxLength": 500, "format": "uri", "pattern": "^(?:https?://[^/?#\\s@]+(?:/[^?#\\s]*)?|urn:[a-z0-9][a-z0-9-]{0,31}:[^?#\\s]+)$"},
        "resource_id": {"$ref": "#/$defs/identifier"},
        "resource_type": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "version_id": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    "immutableReference": {
      "allOf": [{"$ref": "#/$defs/reference"}, {"required": ["version_id"]}]
    },
    "relationship": {
      "type": "object", "additionalProperties": false, "required": ["type", "target"],
      "properties": {"type": {"$ref": "#/$defs/identifier"}, "target": {"$ref": "#/$defs/reference"}}
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "reference", "record_revision", "aliases", "relationships", "extensions"],
      "properties": {
        "schema_version": {"const": 1},
        "reference": {"$ref": "#/$defs/reference"},
        "record_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "aliases": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/reference"}},
        "relationships": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/relationship"}},
        "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]+$"}}
      }
    }
  }
}
