{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:categori:workspace-contracts:business-context:v1",
  "title": "Project business context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "workspace_id",
    "home_account_id",
    "related_account_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "workspace_id": {
      "$ref": "#/$defs/identifier"
    },
    "home_account_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "related_account_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$(?![\\s\\S])"
    }
  }
}
