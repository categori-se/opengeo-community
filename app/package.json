{
  "name": "opengeo-tools-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "observable preview --host 0.0.0.0",
    "build": "observable build",
    "build:studio": "node scripts/build-studio-site.mjs",
    "build:demo": "node scripts/build-demo-site.mjs",
    "build:demo:managed": "node scripts/build-managed-demo-site.mjs",
    "build:public": "node scripts/build-public-site.mjs",
    "build:unified": "node scripts/build-unified-site.mjs",
    "render:auth-config": "node scripts/render-auth-config.mjs",
    "prepare:studio": "npm run build:studio && npm run render:auth-config && node scripts/prepare-studio-release.mjs",
    "check:studio-build": "node scripts/check-studio-build.mjs",
    "check:studio-pwa": "node scripts/check-studio-pwa.mjs",
    "check:studio-release": "node scripts/check-studio-release.mjs",
    "check:public": "npm run build:public && node scripts/check-public-bundle.mjs",
    "deploy:studio": "node scripts/deploy-studio-site.mjs",
    "rollback:studio": "node scripts/rollback-studio-site.mjs",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.mjs\"",
    "check:pages": "npm test && npm run build:studio && node scripts/check-pages.mjs --without-ux-002 && node scripts/check-pages.mjs --ux-002",
    "check:demo:massgis": "node scripts/check-demo-massgis.mjs",
    "check:open-3d-source": "node scripts/check-open-3d-scene-source.mjs"
  },
  "dependencies": {
    "@categori/workspace-contracts": "file:vendor/workspace-contracts",
    "@lezer/html": "1.3.13",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@noble/hashes": "2.0.1",
    "@observablehq/framework": "^1.13.3",
    "@observablehq/notebook-kit": "2.5.6",
    "@observablehq/plot": "^0.6.17",
    "cesium": "1.145.0",
    "d3": "^7.9.0",
    "fflate": "0.8.3",
    "geotiff": "3.1.0-beta.0",
    "hyparquet": "1.31.1",
    "hyparquet-compressors": "1.1.2",
    "mapbox-gl": "3.30.0",
    "maplibre-gl": "6.4.1",
    "markdown-it": "14.2.0",
    "monaco-editor": "0.56.0",
    "ol": "10.10.0",
    "path-browserify": "1.0.1",
    "pmtiles": "^4.4.1",
    "proj4": "2.22.0",
    "rbush": "4.0.1",
    "earcut": "3.2.3"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.5",
    "@maplibre/geojson-vt": "6.1.0",
    "@maplibre/vt-pbf": "4.3.2",
    "jsdom": "23.2.0",
    "pbf": "4.0.2",
    "playwright": "^1.56.1"
  },
  "overrides": {
    "brace-expansion": "2.1.7",
    "esbuild": "0.28.2",
    "js-yaml": "3.15.2",
    "linkify-it": "5.0.2",
    "source-map-js": "1.2.2",
    "tar": "7.5.22"
  },
  "license": "Apache-2.0"
}
